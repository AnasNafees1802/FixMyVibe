# Normalize line endings so scripts work on every OS.
* text=auto

# Shell scripts must be LF or they fail on Linux and macOS ("bad interpreter").
*.sh   text eol=lf

# The rule pack and the corpus are read line by line by both engines. Keep them LF everywhere.
*.conf text eol=lf
tests/corpus.txt text eol=lf

# PowerShell is happiest with CRLF on Windows.
*.ps1  text eol=crlf

# Docs stay LF for clean diffs.
*.md   text eol=lf
